# MatruCare AI Hackathon Portal - Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# e.g. mongodb://localhost:27017/hackathon_portal OR MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/hackathon_portal

# JWT Secret for Token Signing
JWT_SECRET=matrucare_ai_super_secret_jwt_key_2026

# Nodemailer SMTP Configuration
# Official Company Email: matrucareai@gmail.com
# Use Google App Password (not your personal Gmail login password)
EMAIL_USER=matrucareai@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:5173
