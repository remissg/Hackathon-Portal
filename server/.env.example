# MatruCare AI Hackathon Portal - Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# e.g. MongoDB Atlas or Local MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hackathon_portal?retryWrites=true&w=majority

# JWT Secret for Token Signing
JWT_SECRET=matrucare_ai_super_secret_jwt_key_2026

# Nodemailer SMTP Configuration
# 1. EMAIL_USER: Your own personal Gmail address (used for SMTP authentication)
EMAIL_USER=your_personal_email@gmail.com

# 2. EMAIL_PASS: 16-character Gmail App Password (created in Google Account > Security)
EMAIL_PASS=your_16_character_gmail_app_password

# 3. EMAIL_FROM: Official MatruCare AI sender address
EMAIL_FROM=matrucareai@gmail.com

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:5173

